<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.icet.controller.purchase.PurchaseFromController"
            prefHeight="678.0" prefWidth="900.0"
            style="-fx-background-color: #f7f7f7;">

    <top>
        <HBox spacing="10" style="-fx-padding: 16;" alignment="CENTER_LEFT">
            <Label text="Purchases" style="-fx-font-size: 22; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Refresh" onAction="#refreshOnAction" />
        </HBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.55">
            <items>
                <!-- Left: Create purchase order -->
                <VBox spacing="12" style="-fx-padding: 16;">
                    <Label text="Create Purchase Order" style="-fx-font-size: 16; -fx-font-weight: bold;" />

                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>

                        <Label text="Supplier ID" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                        <TextField fx:id="txtSupplierId" promptText="ex: 1" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                        <Label text="Order Date" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                        <DatePicker fx:id="dpOrderDate" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                        <Label text="Status" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                        <ComboBox fx:id="cmbStatus" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                    </GridPane>

                    <Separator />

                    <Label text="Add Items" style="-fx-font-size: 14; -fx-font-weight: bold;" />

                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>

                        <Label text="Medicine ID" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                        <TextField fx:id="txtMedicineId" promptText="ex: 101" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                        <Label text="Medicine Name" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                        <TextField fx:id="txtMedicineName" promptText="ex: Paracetamol" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                        <Label text="Quantity" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                        <TextField fx:id="txtQuantity" promptText="ex: 10" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                        <Label text="Buy Price" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                        <TextField fx:id="txtBuyPrice" promptText="ex: 25.00" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                    </GridPane>

                    <HBox spacing="10">
                        <Button text="Add Item" onAction="#addItemOnAction" />
                        <Button text="Remove Selected" onAction="#removeSelectedItemOnAction" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button text="Save Purchase" style="-fx-background-color: #0f766e; -fx-text-fill: white;" onAction="#savePurchaseOnAction" />
                    </HBox>

                    <TableView fx:id="tblItems" prefHeight="220">
                        <columns>
                            <TableColumn fx:id="colItemMedicineId" text="Medicine ID" prefWidth="100" />
                            <TableColumn fx:id="colItemMedicineName" text="Name" prefWidth="170" />
                            <TableColumn fx:id="colItemQty" text="Qty" prefWidth="70" />
                            <TableColumn fx:id="colItemBuyPrice" text="Buy Price" prefWidth="100" />
                            <TableColumn fx:id="colItemLineTotal" text="Line Total" prefWidth="100" />
                        </columns>
                    </TableView>

                    <HBox spacing="14">
                        <Label text="Items: " />
                        <Label fx:id="lblItemCount" text="0" style="-fx-font-weight: bold;" />
                        <Label text="Total Amount: " />
                        <Label fx:id="lblOrderTotal" text="0.00" style="-fx-font-weight: bold;" />
                    </HBox>

                    <Label fx:id="lblMessage" text="" style="-fx-text-fill: #444;" />
                </VBox>

                <!-- Right: Summary + purchase history -->
                <VBox spacing="12" style="-fx-padding: 16;">
                    <Label text="Purchase Summary" style="-fx-font-size: 16; -fx-font-weight: bold;" />

                    <HBox spacing="14" style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 10;">
                        <VBox spacing="6">
                            <Label text="Total Purchase Orders" style="-fx-text-fill: #666;" />
                            <Label fx:id="lblTotalPurchaseOrders" text="0" style="-fx-font-size: 22; -fx-font-weight: bold;" />
                        </VBox>
                        <VBox spacing="6">
                            <Label text="Total Purchase Amount" style="-fx-text-fill: #666;" />
                            <Label fx:id="lblTotalPurchaseAmount" text="0.00" style="-fx-font-size: 22; -fx-font-weight: bold;" />
                        </VBox>
                    </HBox>

                    <Label text="Purchase History" style="-fx-font-size: 14; -fx-font-weight: bold;" />
                    <TableView fx:id="tblPurchaseOrders" prefHeight="420">
                        <columns>
                            <TableColumn fx:id="colPOId" text="PO ID" prefWidth="70" />
                            <TableColumn fx:id="colSupplierId" text="Supplier" prefWidth="90" />
                            <TableColumn fx:id="colOrderDate" text="Date" prefWidth="110" />
                            <TableColumn fx:id="colTotalAmount" text="Total" prefWidth="100" />
                            <TableColumn fx:id="colStatus" text="Status" prefWidth="110" />
                        </columns>
                    </TableView>

                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>
